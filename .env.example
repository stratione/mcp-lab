# MCP DevOps Lab — Environment Configuration
# ============================================
# This file is SCREEN-SAFE — no secrets here!
# API keys live in .env.secrets (never share that file).
#
# Quick start:
#   ./scripts/1-setup.sh
#   # .env and .env.secrets are created automatically on first run.
#   # Edit .env.secrets to add cloud LLM API keys (optional — Ollama works without them).

# ──── MCP Server Profiles ─────────────────────────────
# Controls which MCP servers start with 'docker compose up -d' (or 'podman compose')
# Add profiles as comma-separated values:
#   user       → +6 user tools (port 8003)
#   gitea      → +10 git/repo/CI tools (port 8004)
#   registry   → +4 registry tools (port 8005)
#   promotion  → +6 promotion/scan/rollback tools (port 8006)
#   runner     → +3 build/scan/deploy tools (port 8007)
# Infra-only profiles (no MCP tools; started by the full tier):
#   ci         → act-runner (Gitea Actions runner)
#   security   → trivy server (host port 8087)
# Examples:
#   COMPOSE_PROFILES=                                     # no MCP servers (default)
#   COMPOSE_PROFILES=user                                 # user tools only
#   COMPOSE_PROFILES=user,gitea,registry,promotion,runner # every MCP tool
COMPOSE_PROFILES=

# Gitea token (generated by bootstrap, paste here after first run)
GITEA_TOKEN=your-gitea-token-here

# Gitea Actions runner registration token (full tier only). Minted by
# 2-setup.sh via `gitea actions generate-runner-token` after Gitea is
# healthy; act-runner reads it at first start to register itself.
RUNNER_REGISTRATION_TOKEN=

# ──── LLM Provider Defaults ───────────────────────────
# Options: ollama, openai, anthropic, google
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Ollama URL — choose the right one for your setup:
#   Docker Desktop (Mac/Windows): http://host.docker.internal:11434  (default)
#   Podman on macOS:              http://host.containers.internal:11434
#   Linux (native Docker):        http://172.17.0.1:11434
OLLAMA_URL=http://host.docker.internal:11434

# Container engine (auto-detected by setup script)
CONTAINER_ENGINE=docker

# Absolute path to your local checkout — populated automatically by the setup
# script so docker compose can bind-mount the repo into containers.
HOST_PROJECT_DIR=

# Lab tier — small (default, ~6GB RAM) | medium | large | full.
# Controls which Ollama model gets pulled and which MCP servers pre-build.
# full = large + Gitea Actions CI runner + Trivy scanner. New host ports in
# large/full: registry-staging :5003, trivy :8087 (next to registry-dev
# :5001 and registry-prod :5002).
MCP_LAB_TIER=small

# Lab edition — gui (default; Chat UI on :3001) | cli (no Chat UI; drive
# the lab with ./labctl). Persisted by 2-setup.sh --edition=cli|gui.
MCP_LAB_EDITION=gui
